# Supabase project URL.
# The Vercel Marketplace integration provisions NEXT_PUBLIC_SUPABASE_URL automatically.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable ("anon") key -- safe for the browser. NEVER put the secret key here.
# Vercel integration name:  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Legacy/manual name:       NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
